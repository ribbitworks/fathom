{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "ignorePresets": [
    ":semanticPrefixFixDepsChoreOthers",
    "mergeConfidence:age-confidence-badges"
  ],
  "minimumReleaseAge": "7 days",
  "labels": ["area: dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": null,
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{{prettyNewVersion}}}",
  "commitBody": "{{#each upgrades}}- Move {{{depName}}} from {{{displayFrom}}} to {{{displayTo}}}\n{{/each}}",
  "prBodyColumns": ["Package", "Change"],
  "prBodyNotes": [
    "- Released at least seven days ago, unless it fixes a security vulnerability, or is a PostgreSQL minor release or image digest, which arrive at once."
  ],
  "prBodyTemplate": "{{{table}}}{{{notes}}}{{{changelogs}}}",
  "vulnerabilityAlerts": {
    "labels": ["area: dependencies", "P1"],
    "minimumReleaseAge": null,
    "commitMessageSuffix": ""
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images pinned by digest in scripts",
      "managerFilePatterns": ["/^scripts/.+\\.sh$/"],
      "matchStrings": [
        "_image=\"(?<depName>[^\":@]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "PostgreSQL's minor releases, such as 18.6 to 18.7, and image digest updates carry security fixes from the official publisher. Docker Hub's dates change on every routine rebuild, so the seven-day minimum release age would hold these fixes back; major releases and other images keep it.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "minimumReleaseAge": null
    }
  ],
  "dependencyDashboardLabels": ["area: dependencies"]
}
