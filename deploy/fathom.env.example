# SPDX-License-Identifier: Apache-2.0

# Every setting Fathom's server reads, with placeholder values. Secrets are never set here: settings
# ending in _FILE name a file that holds the secret, such as a container secret.

# The address and port the server listens on. It serves HTTPS only.
FATHOM_HOST=0.0.0.0
FATHOM_PORT=8443

# The HTTPS certificate, with any intermediate certificates, and its private key.
FATHOM_TLS_CERT_FILE=/run/secrets/fathom_tls_cert
FATHOM_TLS_KEY_FILE=/run/secrets/fathom_tls_key

# The database, connected to as the application's role, which can only read and write data.
FATHOM_DB_HOST=postgres
FATHOM_DB_PORT=5432
FATHOM_DB_NAME=fathom
FATHOM_DB_USER=fathom_app
FATHOM_DB_PASSWORD_FILE=/run/secrets/fathom_app_password
