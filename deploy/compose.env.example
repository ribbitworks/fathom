# SPDX-License-Identifier: Apache-2.0

# Every setting deploy/compose.yaml reads on the host, with placeholder values. A server downloads it
# as .env beside compose.yaml and adjusts it, as Installing Fathom sets out. Without a .env file, the
# defaults suit a development machine, using the development secrets and certificate.

# The address and port users reach Fathom on, and the address users type, which must match the
# HTTPS certificate.
FATHOM_BIND_ADDRESS=10.0.0.10
FATHOM_HTTPS_PORT=443
FATHOM_PUBLIC_URL=https://fathom.example.internal

# The folder holding the database passwords and the session secret, one file each:
# postgres_superuser_password, fathom_migrator_password, fathom_app_password, and fathom_auth_secret,
# which holds at least 32 random characters. Compose gives each container the file with its
# owner and permissions on the host, and the containers read them as their own users, so the files
# must be readable by all (mode 644), inside a folder only the account that runs Fathom can open.
FATHOM_SECRETS_DIR=/srv/fathom/secrets

# The HTTPS certificate, with any intermediate certificates, and its private key, kept like the
# passwords above.
FATHOM_TLS_CERT=/srv/fathom/secrets/fathom_tls_cert.pem
FATHOM_TLS_KEY=/srv/fathom/secrets/fathom_tls_key.pem

# The registry and owner a release's images are published to, without a trailing slash, and the
# release to run, without its v, such as 0.1.0, whose images Docker pulls. Leave FATHOM_REGISTRY empty
# only on a development machine, to run images built there, named fathom-app and so on.
FATHOM_REGISTRY=ghcr.io/ribbitworks
FATHOM_IMAGE_TAG=0.1.0

# Only for images built on a development machine, never a release's published images, which hold
# their own: the date that decides which security fixes a build fetches, a new date fetching them
# again; and the release, short commit and commit date, such as 2026-10-30, that Help's About box
# shows, which the scripts read from git, overriding these.
FATHOM_SECURITY_FIXES_DATE=2026-10-30
FATHOM_VERSION=
FATHOM_COMMIT=
FATHOM_COMMIT_DATE=
