{
  "name": "fathom",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=24.22.1 <27"
  },
  "scripts": {
    "bootstrap": "bash scripts/dev-bootstrap.sh",
    "lint": "eslint --max-warnings 0 --cache --cache-location .tmp/eslint/ .",
    "lint:md": "markdownlint --ignore-path .gitignore \"**/*.md\"",
    "lint:shell": "bash scripts/lint-shell.sh",
    "lint:duplicates": "node scripts/lint-duplicates.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bash scripts/check.sh",
    "check:push": "bash scripts/check.sh --before-push",
    "lint:licences": "bash scripts/lint-licences.sh",
    "lint:renovate": "bash scripts/validate-renovate.sh",
    "security": "bash scripts/security-report.sh",
    "scan:images": "bash scripts/scan-images.sh",
    "test": "pnpm test:scripts && pnpm test:packages",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:packages": "node scripts/package-tests.mjs --recursive --parallel --no-bail --if-present test",
    "test:changed": "node scripts/test-changed.mjs",
    "updates": "bash scripts/check-updates.sh",
    "offline:prepare": "bash scripts/offline-prepare.sh",
    "reset-caches": "bash scripts/reset-caches.sh",
    "prune-reports": "node scripts/prune-reports.mjs",
    "release": "node scripts/release.mjs",
    "release:tag": "node scripts/release.mjs --tag",
    "publish:images": "bash scripts/publish-images.sh",
    "dev:setup": "bash scripts/dev-setup.sh",
    "dev:reset": "bash scripts/dev-reset.sh",
    "dev": "bash scripts/dev.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "db:up": "bash scripts/dev-db.sh up",
    "db:down": "bash scripts/dev-db.sh down",
    "db:migrate": "bash scripts/dev-db.sh migrate",
    "db:reset": "bash scripts/dev-db.sh reset",
    "db:seed": "bash scripts/dev-db.sh seed",
    "db:unseed": "bash scripts/dev-db.sh unseed",
    "db:reseed": "bash scripts/dev-db.sh reseed",
    "db:seed:accounts": "bash scripts/dev-db.sh seed-accounts",
    "stack:up": "bash scripts/stack.sh up",
    "stack:down": "bash scripts/stack.sh down",
    "stack:reset": "bash scripts/stack.sh reset",
    "stack:logs": "bash scripts/stack.sh logs",
    "stack:create-account": "bash scripts/stack.sh create-account",
    "stack:create-administrator": "bash scripts/stack.sh create-administrator",
    "account:create": "bash scripts/create-account.sh",
    "admin:create": "bash scripts/create-administrator.sh",
    "test:ui": "bash scripts/test-ui.sh",
    "test:containers": "node --test --test-timeout=1800000 \"scripts/container-tests/*.test.mjs\"",
    "typecheck": "tsc --build",
    "build": "pnpm --filter @fathom/web build"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "jscpd": "5.4.3",
    "markdownlint-cli": "0.50.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
